APP_NAME=CareerPilot AI
APP_VERSION=0.1.0
ENVIRONMENT=development

# PostgreSQL
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

FRONTEND_URL=http://localhost:3000

# Authentication
JWT_SECRET_KEY=change-this-development-secret
JWT_ALGORITHM=HS256

# Optional OpenAI integration
OPENAI_API_KEY=
OPENAI_MODEL=

# Web automation
SCRAPING_PROXY_ENABLED=false

# Comma-separated authorized proxy endpoints.
# Example:
# SCRAPING_PROXIES=http://127.0.0.1:8080,http://127.0.0.1:8081

SCRAPING_PROXIES=